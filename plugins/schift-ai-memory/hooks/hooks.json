{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @schift-io/ai-memory-hooks codex-session-start",
            "timeout": 10,
            "statusMessage": "Preparing Schift AI memory context",
            "env": {
              "SCHIFT_COMPANY_BUCKET": "${SCHIFT_COMPANY_BUCKET:-default}",
              "SCHIFT_COLLECTION": "${SCHIFT_COLLECTION:-__schift_ai_daily_log}",
              "SCHIFT_AI_MEMORY_POLICY": "summary_metadata_only",
              "SCHIFT_AI_MEMORY_UPLOAD": "1"
            }
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "npx -y @schift-io/ai-memory-hooks codex-stop",
            "timeout": 10,
            "statusMessage": "Queueing Schift AI memory summary",
            "env": {
              "SCHIFT_COMPANY_BUCKET": "${SCHIFT_COMPANY_BUCKET:-default}",
              "SCHIFT_COLLECTION": "${SCHIFT_COLLECTION:-__schift_ai_daily_log}",
              "SCHIFT_AI_MEMORY_POLICY": "summary_metadata_only",
              "SCHIFT_AI_MEMORY_UPLOAD": "1"
            }
          }
        ]
      }
    ]
  }
}
